# .env.example -> copialo como .env y ajusta los valores (el .env NO se sube a Git).
#   PowerShell:  Copy-Item .env.example .env
# En un ambiente real, cambia las contrasenas.

AIRFLOW_UID=50000

# Credenciales de MinIO (las usan MinIO, Airflow y los dashboards)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123

# Modelo de IA local del asistente (Semana 17)
OLLAMA_MODEL=llama3.2:3b
