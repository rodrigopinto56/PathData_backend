FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    streamlit==1.38.0 \
    pandas \
    s3fs \
    plotly \
    pyyaml \
    scipy

COPY dashboard/ /app/
# Semana 13: logica de negocio compartida con el reporte que publica el DAG
COPY scripts/reporte_ejecutivo.py /app/
# Semana 16: el simulador corre en vivo en el dashboard (mismo codigo y
# configuracion que la tarea simular_escenarios del DAG)
COPY scripts/simulador_montecarlo.py /app/
COPY config/simulador.yml /app/

EXPOSE 8501

CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501"]
